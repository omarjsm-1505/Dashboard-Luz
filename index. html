<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luz · Seguimiento de Presupuesto</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#1B1316;
    --bg-deep:#140D0F;
    --card: rgba(37, 26, 30, 0.85);
    --card-hi: rgba(46, 32, 36, 0.95);
    --line: rgba(212,175,106,0.16);
    --wine:#8C1D40;
    --wine-light:#C1466E;
    --gold:#D4AF6A;
    --gold-dim:#8A7550;
    --cream:#F4EDE4;
    --muted:#A8949A;
    --good:#5FA372;
    --good-glow: rgba(95,163,114,0.35);
    --warn:#D97A46;
    --warn-glow: rgba(217,122,70,0.3);
    --danger:#C14646;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background-color: var(--bg);
    color:var(--cream);
    font-family:'Inter', sans-serif;
    -webkit-font-smoothing:antialiased;
    position: relative;
    min-height: 100vh;
  }

  /* FONDO CON MARCA DE AGUA DEL LOGO CORPORATIVO */
  body::before {
    content: "";
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(to bottom, rgba(27, 19, 22, 0.85), rgba(20, 13, 15, 0.92)),
      url('1275044.jpg');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 650px auto;
    opacity: 0.25;
    z-index: -1;
    pointer-events: none;
  }

  .wrap{max-width:1180px; margin:0 auto; padding:0 28px 80px;}

  /* ===== HERO ===== */
  .hero{
    padding:52px 0 40px;
    display:grid;
    grid-template-columns: 1.3fr 1fr;
    gap:40px;
    align-items:center;
    border-bottom:1px solid var(--line);
    margin-bottom:44px;
  }
  
  .logo-header {
    height: 60px;
    margin-bottom: 20px;
    display: block;
    filter: drop-shadow(0px 4px 10px rgba(0,0,0,0.5));
  }

  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    text-transform:uppercase;
    letter-spacing:2.5px;
    font-size:11.5px;
    color:var(--gold);
    margin:0 0 14px;
  }
  h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(32px,4.2vw,50px);
    line-height:1.05;
    margin:0 0 16px;
    letter-spacing:-0.5px;
  }
  h1 em{ font-style:italic; color:var(--wine-light); font-weight:500;}
  .hero-sub{
    color:var(--muted);
    font-size:15px;
    line-height:1.6;
    max-width:46ch;
    margin:0 0 20px;
  }
  .corte-pill{
    display:inline-flex;
    gap:10px;
    align-items:center;
    font-family:'JetBrains Mono', monospace;
    font-size:12.5px;
    color:var(--cream);
    background:var(--card);
    border:1px solid var(--line);
    padding:8px 14px;
    border-radius:100px;
    backdrop-filter: blur(8px);
  }
  .corte-pill b{color:var(--gold); font-weight:600;}

  /* gauge */
  .gauge-box{ display:flex; flex-direction:column; align-items:center; gap:10px;}
  .gauge-wrap{ position:relative; width:230px; height:230px;}
  .gauge-wrap svg{ transform:rotate(-90deg); width:100%; height:100%;}
  .gauge-center{
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  .gauge-center .big{ font-family:'Fraunces', serif; font-size:44px; font-weight:600; color:var(--cream); line-height:1;}
  .gauge-center .lbl{ font-family:'JetBrains Mono', monospace; font-size:10.5px; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); margin-top:6px;}
  .gauge-legend{ display:flex; gap:18px; font-size:12px; color:var(--muted);}
  .gauge-legend span{display:inline-flex; align-items:center; gap:6px;}
  .dot{width:8px; height:8px; border-radius:50%; display:inline-block;}

  /* ===== TOGGLE ===== */
  .section-head{
    display:flex; justify-content:space-between; align-items:flex-end; gap:20px;
    margin-bottom:22px; flex-wrap:wrap;
  }
  .section-title{
    font-family:'Fraunces', serif; font-size:24px; font-weight:600; margin:0;
  }
  .section-title span{ color:var(--muted); font-size:13px; font-family:'Inter'; font-weight:400; display:block; margin-top:4px;}
  .toggle{
    display:inline-flex; background:var(--card); border:1px solid var(--line);
    border-radius:100px; padding:4px; backdrop-filter: blur(8px);
  }
  .toggle button{
    border:none; background:transparent; color:var(--muted);
    font-family:'Inter'; font-weight:600; font-size:13px;
    padding:9px 20px; border-radius:100px; cursor:pointer;
    transition:all .25s ease;
  }
  .toggle button.active{
    background:linear-gradient(135deg, var(--wine), var(--wine-light));
    color:var(--cream);
    box-shadow:0 4px 14px rgba(140,29,64,0.4);
  }

  /* ===== KPI CARDS ===== */
  .kpis{
    display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:56px;
  }
  .kpi{
    background:var(--card); border:1px solid var(--line); border-radius:16px;
    padding:20px 16px; position:relative; overflow:hidden;
    backdrop-filter: blur(10px);
  }
  .kpi::before{
    content:""; position:absolute; top:0; left:0; width:3px; height:100%;
    background:var(--gold-dim);
  }
  .kpi.neg::before{ background:var(--warn);}
  .kpi.pos::before{ background:var(--good);}
  .kpi .k-lbl{ font-family:'JetBrains Mono', monospace; font-size:10px; text-transform:uppercase; letter-spacing:1px; color:var(--muted); margin-bottom:8px;}
  .kpi .k-val{ font-family:'Fraunces', serif; font-size:24px; font-weight:600; color:var(--cream); line-height:1.1;}
  .kpi .k-sub{ font-size:11.5px; color:var(--muted); margin-top:6px;}
  .kpi .k-sub.warn{ color:var(--warn);}
  .kpi .k-sub.good{ color:var(--good);}

  /* ===== RANKING CON LÍNEA DE META ===== */
  .ranking{ margin-bottom:60px;}
  .row{
    display:grid;
    grid-template-columns: 26px 150px 1fr 92px 130px;
    align-items:center;
    gap:16px;
    padding:13px 0;
    border-bottom:1px solid var(--line);
  }
  .row.head{
    font-family:'JetBrains Mono', monospace; font-size:10.5px; text-transform:uppercase;
    letter-spacing:1px; color:var(--muted); border-bottom:1px solid var(--line); padding-bottom:12px;
  }
  .row .rank{ font-family:'JetBrains Mono', monospace; color:var(--gold-dim); font-size:13px;}
  .row.top .rank{ color:var(--gold);}
  .row .name{ font-weight:600; font-size:14px; }
  .row.top .name{ color:var(--gold);}
  
  .bar-track{
    position:relative; height:26px; background:rgba(20, 13, 15, 0.7);
    border-radius:6px; overflow:visible; border:1px solid var(--line);
  }
  .bar-fill{
    position:absolute; top:0; left:0; height:100%;
    border-radius:6px;
    background:linear-gradient(90deg, var(--wine), var(--wine-light));
    transition:width 1s cubic-bezier(.16,1,.3,1);
    display:flex; align-items:center; justify-content:flex-end;
    padding-right:8px;
  }
  .bar-fill.top{ background:linear-gradient(90deg, #3E7A54, var(--good));}
  .bar-fill .pct-in{ font-family:'JetBrains Mono', monospace; font-size:11px; color:rgba(255,255,255,0.9); font-weight:700;}
  
  .target-line{
    position:absolute; top:-4px; bottom:-4px; width:2px; background:var(--gold);
    z-index:10; box-shadow: 0 0 6px var(--gold);
  }

  .row .pct-out{ font-family:'JetBrains Mono', monospace; font-size:12.5px; color:var(--muted); text-align:right;}
  .row .diff{ font-family:'JetBrains Mono', monospace; font-size:12.5px; text-align:right;}
  .diff.warn{ color:var(--warn);}
  .diff.good{ color:var(--good);}

  /* ===== ESTATUS SEMÁFORO ===== */
  .badge{
    display:inline-block; font-size:10px; font-weight:700; font-family:'JetBrains Mono', monospace;
    padding:3px 8px; border-radius:100px; text-transform:uppercase;
  }
  .badge.meta{ background:rgba(95,163,114,0.15); color:var(--good); border:1px solid var(--good);}
  .badge.obs{ background:rgba(217,122,70,0.15); color:var(--warn); border:1px solid var(--warn);}
  .badge.riesgo{ background:rgba(193,70,70,0.15); color:var(--danger); border:1px solid var(--danger);}

  /* ===== TABLE ===== */
  .table-section{ margin-bottom:40px;}
  .tbl-scroll{ overflow-x:auto; border:1px solid var(--line); border-radius:16px; backdrop-filter: blur(10px);}
  table{ width:100%; border-collapse:collapse; min-width:760px; background:var(--card);}
  thead th{
    text-align:right; font-family:'JetBrains Mono', monospace; font-size:10.5px;
    text-transform:uppercase; letter-spacing:1px; color:var(--gold);
    padding:16px 18px; border-bottom:1px solid var(--line); white-space:nowrap;
    background:var(--card-hi);
  }
  thead th:first-child{ text-align:left;}
  tbody td{ text-align:right; padding:13px 18px; font-size:13px; border-bottom:1px solid var(--line); font-family:'JetBrains Mono', monospace; color:var(--cream);}
  tbody td:first-child{ text-align:left; font-family:'Inter'; font-weight:600;}
  tbody tr:last-child td{ border-bottom:none;}
  tbody tr.total td{ background:var(--card-hi); font-weight:700; color:var(--gold);}
  tbody tr:hover td{ background:rgba(212,175,106,0.08);}
  td.warn{ color:var(--warn);}
  td.good{ color:var(--good);}

  footer{
    text-align:center; color:var(--muted); font-size:12px; padding-top:20px;
    border-top:1px solid var(--line); font-family:'JetBrains Mono', monospace;
  }

  @media (max-width:1024px){
    .kpis{ grid-template-columns:repeat(3,1fr); }
  }
  @media (max-width:860px){
    .hero{ grid-template-columns:1fr; }
    .kpis{ grid-template-columns:repeat(2,1fr);}
    .row{ grid-template-columns: 20px 96px 1fr 70px; }
    .row .diff{ display:none;}
    .row.head{ grid-template-columns: 20px 96px 1fr 70px; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- HERO -->
  <section class="hero">
    <div>
      <!-- LOGO CORPORATIVO CORTADO/INSERTADO DE LA IMAGEN -->
      <img src="1275044.jpg" alt="Automercados Luz Logo" class="logo-header">
      <p class="eyebrow">Seguimiento de presupuesto</p>
      <h1>Cómo va <em>cada sucursal</em><br>frente a su meta.</h1>
      <p class="hero-sub">Cumplimiento consolidado de las 10 sucursales, en valor y en unidades, contra el presupuesto asignado del mes.</p>
      <div class="corte-pill">◆ Corte al <b>23 de julio, 2026</b></div>
    </div>
    <div class="gauge-box">
      <div class="gauge-wrap">
        <svg viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="86" fill="none" stroke="#2E2024" stroke-width="14"/>
          <circle cx="100" cy="100" r="86" fill="none" stroke="url(#gradValor)" stroke-width="14"
            stroke-linecap="round" stroke-dasharray="540.35" stroke-dashoffset="160.5" id="arcValor"/>
          <circle cx="100" cy="100" r="66" fill="none" stroke="#2E2024" stroke-width="12"/>
          <circle cx="100" cy="100" r="66" fill="none" stroke="url(#gradUnid)" stroke-width="12"
            stroke-linecap="round" stroke-dasharray="414.7" stroke-dashoffset="117.9" id="arcUnid"/>
          <defs>
            <linearGradient id="gradValor" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#8C1D40"/><stop offset="100%" stop-color="#C1466E"/>
            </linearGradient>
            <linearGradient id="gradUnid" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#B98F3E"/><stop offset="100%" stop-color="#D4AF6A"/>
            </linearGradient>
          </defs>
        </svg>
        <div class="gauge-center">
          <div class="big">70,3%</div>
          <div class="lbl">Cumplimiento global</div>
        </div>
      </div>
      <div class="gauge-legend">
        <span><i class="dot" style="background:var(--wine-light)"></i>Valor $ 70,31%</span>
        <span><i class="dot" style="background:var(--gold)"></i>Unidades 71,56%</span>
      </div>
    </div>
  </section>

  <!-- KPIS -->
  <div class="section-head">
    <h2 class="section-title">Resumen del mes<span>Totales consolidados a la fecha de corte</span></h2>
    <div class="toggle" id="toggleTop">
      <button data-mode="valor" class="active">Valor $</button>
      <button data-mode="unidades">Unidades</button>
    </div>
  </div>
  <div class="kpis" id="kpiGrid"></div>

  <!-- RANKING -->
  <section class="ranking">
    <div class="section-head">
      <h2 class="section-title">Ranking por sucursal<span>Línea vertical dorada = Velocidad ideal teórica (74,19%)</span></h2>
    </div>
    <div class="row head">
      <span>#</span><span>Sucursal</span><span>Cumplimiento vs. Meta (74,19%)</span><span style="text-align:right">%</span><span style="text-align:right">vs. presupuesto</span>
    </div>
    <div id="rankingList"></div>
  </section>

  <!-- TABLE -->
  <section class="table-section">
    <div class="section-head">
      <h2 class="section-title">Detalle completo<span>Presupuesto, cumplimiento, estatus y proyección</span></h2>
    </div>
    <div class="tbl-scroll">
      <table>
        <thead>
          <tr>
            <th>Sucursal</th>
            <th>Estatus</th>
            <th>Presupuesto</th>
            <th>Cumplimiento</th>
            <th>%</th>
            <th>% Part.</th>
            <th>Proyección</th>
            <th>≠ Ppto.</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
    </div>
  </section>

  <footer>LUZ · SEGUIMIENTO_JULIO_2026 · Costo promedio: presupuesto 2,15 / real 2,11</footer>
</div>

<script>
const targetPct = 74.19;

const data = [
  {n:"Carlota", vp:1166881, vc:846283, vpct:72.53, vpart:22.92, vproy:1140642, vdiff:-26239, up:505094, uc:366866, upct:72.63, upart:20.99, uproy:494472, udiff:-10622},
  {n:"Chacao", vp:561736, vc:395590, vpct:70.42, vpart:10.71, vproy:533187, vdiff:-28549, up:281930, uc:201182, upct:71.36, upart:11.51, uproy:271159, udiff:-10771},
  {n:"Dos Caminos", vp:341109, vc:224190, vpct:65.72, vpart:6.07, vproy:302170, vdiff:-38939, up:165215, uc:113602, upct:68.76, upart:6.50, uproy:153116, udiff:-12099},
  {n:"Florida", vp:731985, vc:535528, vpct:73.16, vpart:14.50, vproy:721799, vdiff:-10186, up:336633, uc:251517, upct:74.72, upart:14.39, uproy:339001, udiff:2368},
  {n:"Luz Quick Rest & Market", vp:195119, vc:128208, vpct:65.71, vpart:3.47, vproy:172802, vdiff:-22317, up:98828, uc:65314, upct:66.09, upart:3.74, uproy:88033, udiff:-10796},
  {n:"Llanito", vp:545671, vc:355502, vpct:65.15, vpart:9.63, vproy:479155, vdiff:-66516, up:257886, uc:170643, upct:66.17, upart:9.76, uproy:229997, udiff:-27889},
  {n:"Marques", vp:166498, vc:113436, vpct:68.13, vpart:3.07, vproy:152892, vdiff:-13606, up:83053, uc:57825, upct:69.62, upart:3.31, uproy:77938, udiff:-5115},
  {n:"Pedregal", vp:360241, vc:247643, vpct:68.74, vpart:6.71, vproy:333780, vdiff:-26461, up:179795, uc:126851, upct:70.55, upart:7.26, uproy:170973, udiff:-8822},
  {n:"San Antonio", vp:491697, vc:368046, vpct:74.85, vpart:9.97, vproy:496062, vdiff:4365, up:224427, uc:173100, upct:77.13, upart:9.90, uproy:233308, udiff:8881},
  {n:"Urbina", vp:691063, vc:478351, vpct:69.22, vpart:12.95, vproy:644734, vdiff:-46329, up:310139, uc:221263, upct:71.34, upart:12.66, uproy:298224, udiff:-11915},
];

const totals = {
  valor: {p:5252000, c:3692778, pct:70.31, proy:4977222, diff:-274778},
  unidades: {p:2443000, c:1748163, pct:71.56, proy:2356220, diff:-86780}
};

const fmt = n => Math.round(n).toLocaleString('es-VE');
const fmtSigned = n => (n >= 0 ? '+' : '') + Math.round(n).toLocaleString('es-VE');

let mode = 'valor';

function getStatusBadge(pct){
  const diff = pct - targetPct;
  if(diff >= 0) return `<span class="badge meta">Meta</span>`;
  if(diff >= -4) return `<span class="badge obs">Obs.</span>`;
  return `<span class="badge riesgo">Riesgo</span>`;
}

function renderKPIs(){
  const t = totals[mode];
  const unit = mode === 'valor' ? '$' : '';
  const grid = document.getElementById('kpiGrid');
  grid.innerHTML = `
    <div class="kpi">
      <div class="k-lbl">Presupuesto total</div>
      <div class="k-val">${unit}${fmt(t.p)}</div>
      <div class="k-sub">Meta del mes</div>
    </div>
    <div class="kpi">
      <div class="k-lbl">Cumplido a la fecha</div>
      <div class="k-val">${unit}${fmt(t.c)}</div>
      <div class="k-sub">${t.pct}% de la meta</div>
    </div>
    <div class="kpi">
      <div class="k-lbl">Proyección de cierre</div>
      <div class="k-val">${unit}${fmt(t.proy)}</div>
      <div class="k-sub">${t.proy >= t.p ? 'Cerraría por encima' : 'Cerraría por debajo'} del presupuesto</div>
    </div>
    <div class="kpi ${t.diff < 0 ? 'neg' : 'pos'}">
      <div class="k-lbl">Diferencia proyectada</div>
      <div class="k-val">${unit}${fmtSigned(t.diff)}</div>
      <div class="k-sub ${t.diff < 0 ? 'warn' : 'good'}">${t.diff < 0 ? 'Brecha frente a la meta' : 'Por encima de la meta'}</div>
    </div>
    <div class="kpi">
      <div class="k-lbl">Ticket Promedio</div>
      <div class="k-val">$2,11</div>
      <div class="k-sub warn">Vs. $2,15 Ppto (-1,86%)</div>
    </div>
  `;
}

function renderRanking(){
  const list = document.getElementById('rankingList');
  const pctKey = mode === 'valor' ? 'vpct' : 'upct';
  const diffKey = mode === 'valor' ? 'vdiff' : 'udiff';
  const unit = mode === 'valor' ? '$' : '';
  const sorted = [...data].sort((a,b) => b[pctKey] - a[pctKey]);
  
  list.innerHTML = sorted.map((d,i) => {
    const isTop = i === 0;
    const diff = d[diffKey];
    const pct = d[pctKey];
    return `
    <div class="row ${isTop ? 'top' : ''}">
      <span class="rank">${String(i+1).padStart(2,'0')}</span>
      <span class="name">${d.n}</span>
      <div class="bar-track">
        <div class="bar-fill ${pct >= targetPct ? 'top' : ''}" style="width:${Math.min(pct, 100)}%">
          <span class="pct-in">${pct.toFixed(1)}%</span>
        </div>
        <div class="target-line" style="left:${targetPct}%" title="Meta teórica: ${targetPct}%"></div>
      </div>
      <span class="pct-out">${pct.toFixed(2)}%</span>
      <span class="diff ${diff < 0 ? 'warn' : 'good'}">${unit}${fmtSigned(diff)}</span>
    </div>`;
  }).join('');
}

function renderTable(){
  const body = document.getElementById('tableBody');
  const unit = mode === 'valor' ? '$' : '';
  const pKey = mode === 'valor' ? 'vp' : 'up';
  const cKey = mode === 'valor' ? 'vc' : 'uc';
  const pctKey = mode === 'valor' ? 'vpct' : 'upct';
  const partKey = mode === 'valor' ? 'vpart' : 'upart';
  const proyKey = mode === 'valor' ? 'vproy' : 'uproy';
  const diffKey = mode === 'valor' ? 'vdiff' : 'udiff';
  
  const rows = data.map(d => `
    <tr>
      <td>${d.n}</td>
      <td style="text-align:center;">${getStatusBadge(d[pctKey])}</td>
      <td>${unit}${fmt(d[pKey])}</td>
      <td>${unit}${fmt(d[cKey])}</td>
      <td>${d[pctKey].toFixed(2)}%</td>
      <td>${d[partKey].toFixed(2)}%</td>
      <td>${unit}${fmt(d[proyKey])}</td>
      <td class="${d[diffKey] < 0 ? 'warn' : 'good'}">${unit}${fmtSigned(d[diffKey])}</td>
    </tr>
  `).join('');
  
  const t = totals[mode];
  const totalRow = `
    <tr class="total">
      <td>Total</td>
      <td style="text-align:center;">${getStatusBadge(t.pct)}</td>
      <td>${unit}${fmt(t.p)}</td>
      <td>${unit}${fmt(t.c)}</td>
      <td>${t.pct.toFixed(2)}%</td>
      <td>100%</td>
      <td>${unit}${fmt(t.proy)}</td>
      <td class="${t.diff < 0 ? 'warn' : 'good'}">${unit}${fmtSigned(t.diff)}</td>
    </tr>`;
  body.innerHTML = rows + totalRow;
}

function renderAll(){
  renderKPIs();
